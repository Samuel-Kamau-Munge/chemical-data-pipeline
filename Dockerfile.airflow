ARG AIRFLOW_VERSION=3.1.0
FROM apache/airflow:${AIRFLOW_VERSION}-python3.12

ARG AIRFLOW_VERSION=3.1.0
ARG PYTHON_VERSION=3.12

USER airflow

COPY --chown=airflow:root pyproject.toml README.md /opt/chemical-pipeline/
COPY --chown=airflow:root chemical_pipeline /opt/chemical-pipeline/chemical_pipeline
COPY --chown=airflow:root dbt /opt/chemical-pipeline/dbt

RUN pip install --no-cache-dir \
    "apache-airflow==${AIRFLOW_VERSION}" \
    "kafka-python==2.2.15" \
    "psycopg[binary]==3.2.9" \
    "dbt-core==1.9.0" \
    "dbt-postgres==1.9.0" \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt" \
    && pip install --no-cache-dir --no-deps -e /opt/chemical-pipeline

ENV PYTHONPATH="/opt/chemical-pipeline"
