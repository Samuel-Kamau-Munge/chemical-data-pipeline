# Copy to .env and replace each placeholder with a unique random hex password:
# openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=
PIPELINE_DB_PASSWORD=
DBT_DB_PASSWORD=
PIPELINE_READER_PASSWORD=
# Optional HTTPS Airflow failure webhook; use managed secret injection outside the local demo.
PIPELINE_ALERT_WEBHOOK_URL=
PIPELINE_ALERT_WEBHOOK_TOKEN=

# Airflow container UID for writable local bind mounts.
AIRFLOW_UID=50000
